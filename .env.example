# Credenciais da base de dados.
# Copie este ficheiro para .env e ajuste os valores.
# O .env NAO deve ser publicado no GitHub (ja esta no .gitignore).

# No Virtualmin: host e quase sempre "localhost".
DB_SERVER=localhost
DB_USERNAME=gestao
DB_PASSWORD=
DB_DATABASE=gestao

# false em producao. Com true, os erros de PHP aparecem no browser.
APP_DEBUG=false
